# ==============================================================================
# GIT IGNORE FILE FOR MAKTAB GUIDE
# ==============================================================================

# ---------------------------------------------
# 1. LOCAL GIT DIRECTORY & TEMP FILES
# ---------------------------------------------
.git/
*.log

# ---------------------------------------------
# 2. REFERENCE FOLDER & LARGE FILES
# ---------------------------------------------
# Completely ignore the Reference directory and its contents
Reference/
/Reference/
*.pdf

# ---------------------------------------------
# 3. OS GENERATED FILES
# ---------------------------------------------
# Windows system files
Thumbs.db
Ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS system files
.DS_Store
.apple_desktop
.LSOverride
._*

# ---------------------------------------------
# 4. IDE & CODE EDITOR SETTINGS
# ---------------------------------------------
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# WebStorm / JetBrains
.idea/

# Sublime Text / Atom
*.sublime-project
*.sublime-workspace

# ---------------------------------------------
# 5. NODE DEPENDENCIES & BUILD (If added later)
# ---------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
build/